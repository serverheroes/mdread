# Copy to .env (next to index.js) and fill in. Needed only for `mdread share`.
#
# One-time Cloudflare setup:
#   1. Create a Workers KV namespace (dash → Workers & Pages → KV).
#   2. Deploy worker/worker.js as a Worker with that namespace bound as SHARES,
#      and enable its workers.dev route.
#   3. Create an API token scoped to "Workers KV Storage: Edit" on that account.
#
# Values may be plain text, or 1Password CLI references (op://vault/item/field)
# which are resolved at runtime via `op read` so no secret sits on disk.
#OP_ACCOUNT=my.1password.com
CLOUDFLARE_API_TOKEN=op://API keys/your-kv-token-item/credential
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
MDREAD_KV_NAMESPACE=your-kv-namespace-id
MDREAD_SHARE_URL=https://your-worker.your-subdomain.workers.dev
# Default lifetime of a share, in hours. 0 = never expires.
# Per-share override: mdread share doc.md --ttl 72   (or --forever)
MDREAD_SHARE_TTL_HOURS=24
