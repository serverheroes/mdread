# Copy to .env (next to index.js) and fill in. Needed only for `mdread share`.
#
# Create a scoped API token at https://dash.cloudflare.com/profile/api-tokens
# with "Cloudflare Pages: Read + Edit" on one account — nothing more.
#
# Values may be plain text, or 1Password CLI references (op://vault/item/field)
# which are resolved at runtime via `op read` so no secret sits on disk.
#OP_ACCOUNT=my.1password.com
CLOUDFLARE_API_TOKEN=op://API keys/your-cf-pages-token-item/credential
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
MDREAD_PAGES_PROJECT=mdread-share
